  "tools": {
    "uv": {
      "check": "uv",
      "url": "https://astral.sh/uv/install.sh",
      "args": [],
      "env": {
        "UV_NO_MODIFY_PATH": "1",
        "UV_INSTALL_DIR": "$HOME/.local/bin"
      }
    },
    "rust": {
      "check": "cargo",
      "url": "https://sh.rustup.rs",
      "args": [
        "-y",
        "--profile",
        "minimal",
        "--no-modify-path"
      ]
    },
    "lazygit": {
      "check": "lazygit",
      "command": [
        "go",
        "install",
        "github.com/jesseduffield/lazygit@v0.65.1"
      ],
      "env": {
        "GOBIN": "$HOME/.local/bin"
      }
    }
