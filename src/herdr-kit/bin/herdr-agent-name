#!/bin/sh
# herdr-agent-name — give a pane's agent the name its human chose for it.
#
# herdr's agent name is the one identifier you can address: `herdr agent prompt`
# and `herdr-agents send` both take it, and neither takes a label or a title. It
# is also the one identifier nothing ever sets, so in practice it stays null and
# every pane is reachable only as w1:p6. This closes that gap by copying the
# name the agent already has — Claude Code's `/rename` — into herdr.
#
#   herdr-agent-name                  # sync the pane this process is in
#   herdr-agent-name --pane w1:p3     # or that one
#   herdr-agent-name --all            # every pane holding a session
#   herdr-agent-name --all --dry-run  # what it would do, changing nothing
#   herdr-agent-name --clear          # drop the name back to null
#
# WHY THIS IS NOT A CLAUDE CODE HOOK. The dotfiles ancestor was one: three
# entries in ~/.claude/settings.json (SessionStart, UserPromptSubmit, Stop),
# reached through a ~/.local/bin symlink, reading the hook's stdin JSON for a
# session_id. That works and is the wrong shape, for the reason bin/herdr-title's
# header gives at length — per-agent hook wiring is a set of absolute paths that
# each die silently, and it has to be re-done for every agent kind. herdr already
# knows the mapping. `herdr pane list` carries .agent_session.value, which for a
# Claude pane *is* the session id the hook would have handed us. So the same
# pane.agent_status_changed subscription that drives the label drives this, and
# there is nothing in ~/.claude/settings.json to keep in sync.
#
# WHICH NAMES SYNC. Only ones a human typed. Claude seeds every session with
# "<cwd-basename>-<2 hex>" (dev-env-fd, ariel-zilbershteyin-52), which says less
# than the pane id already does, and naming a pane that would be worse than
# leaving it null. The session file marks the difference itself —
# "nameSource":"derived" on a seeded name, absent once `/rename` has run — so
# that field decides, and the ancestor's reconstruct-the-stem-from-cwd test is
# kept only as a fallback for a Claude old enough not to write the field.
#
# NO CACHE, unlike the ancestor, which kept the last synced name under
# XDG_CACHE_HOME to avoid a socket round trip per turn. Both identifiers are
# already in hand here — the roster query returns the current agent name beside
# the session id — so the no-op case is decided from data we had to fetch
# anyway, and a `herdr agent rename` typed by hand is noticed rather than
# masked by a stale cache entry.
#
# SLUGGING. herdr enforces ^[a-z][a-z0-9_-]{0,31}$ and rejects anything else
# outright, so PROE-7632-review-master lands as proe-7632-review-master. The two
# are meant to differ: herdr's is an identifier, Claude's is a label.
#
# It lives in bin/ and is POSIX sh for the reason bin/herdr-whoami is: the
# callers are agents shelling out with `sh -c`, which never sourced
# shell/herdr.sh and cannot reach a function defined there.

set -u

usage() {
  cat >&2 <<'EOF'
usage: herdr-agent-name [--all] [--pane <pane-id>] [--dry-run] [--clear] [--quiet]

  (no flags)      sync the pane named by $HERDR_PANE_ID
  --all, -a       sync every pane that holds an agent session
  --pane <id>     sync that pane instead of this one
  --dry-run, -n   report what would change, change nothing
  --clear         clear the agent name instead of setting it
  --quiet, -q     no output; for hooks
EOF
}

all=0
dry=0
clear=0
quiet=0
pane="${HERDR_PANE_ID:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --all|-a)     all=1 ;;
    --dry-run|-n) dry=1 ;;
    --clear)      clear=1 ;;
    --quiet|-q)   quiet=1 ;;
    --pane)       shift; [ $# -gt 0 ] || { echo "herdr-agent-name: --pane needs a pane id" >&2; exit 2; }; pane="$1" ;;
    --pane=*)     pane="${1#--pane=}" ;;
    -h|--help)    usage; exit 0 ;;
    *)            echo "herdr-agent-name: unknown option: $1" >&2; usage; exit 2 ;;
  esac
  shift
done

say()  { [ "$quiet" = 1 ] || printf '%s\n' "$*"; }
die()  { [ "$quiet" = 1 ] || printf 'herdr-agent-name: %s\n' "$*" >&2; exit 1; }

command -v herdr >/dev/null 2>&1 || die "herdr not on PATH"
command -v jq    >/dev/null 2>&1 || die "jq not found"
[ "$all" = 1 ] || [ -n "$pane" ] || die "HERDR_PANE_ID is unset; pass --pane <id> or --all"

# --clear wants no session lookup at all, so it short-circuits the whole roster.
if [ "$clear" = 1 ]; then
  [ "$all" = 1 ] && die "--clear takes one pane, not --all"
  if [ "$dry" = 1 ]; then
    say "$pane	would clear"
  elif herdr agent rename "$pane" --clear >/dev/null 2>&1; then
    say "$pane	cleared"
  else
    die "could not clear $pane"
  fi
  exit 0
fi

# Two calls because the identifiers live in two records: `pane list` carries the
# session ref and never the agent name, `agent list` carries the name and never
# the session ref. Same split bin/herdr-whoami documents. Panes with no session
# are dropped here rather than filtered later — a plain shell pane is not an
# error, it is simply not a candidate.
roster=$(
  { herdr pane list 2>/dev/null; herdr agent list 2>/dev/null; } | jq -s -r '
    (.[0].result.panes // [])                                            as $panes
    | ((.[1].result.agents // []) | map({key: .pane_id, value: .name}) | from_entries) as $named
    | $panes[]
    | select((.agent_session.value // "") != "")
    | [ .pane_id, (.agent // ""), .agent_session.value, ($named[.pane_id] // "") ]
    | @tsv' 2>/dev/null
) || roster=
[ -n "$roster" ] || die "no panes with an agent session (is the server running?)"

[ "$all" = 1 ] || roster=$(printf '%s\n' "$roster" | awk -F'\t' -v p="$pane" '$1 == p')
[ -n "$roster" ] || die "pane $pane holds no agent session"

# One pass over the session files instead of a grep per pane: --all on a grid of
# fifteen would otherwise re-read the directory fifteen times. Malformed or
# half-written files are skipped by the type test rather than aborting the slurp.
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
sessions=$(jq -s -r '
  .[]
  | select(type == "object" and (.sessionId // "") != "")
  | [ .sessionId, (.name // ""), (.nameSource // ""), (.cwd // "") ]
  | @tsv' "$config_dir"/sessions/*.json 2>/dev/null) || sessions=

# herdr's grammar, applied on the way in because herdr rejects rather than
# coerces. Leading non-letters go (herdr wants ^[a-z]), the rest collapses to
# its allowed set, and 32 is the cap it enforces.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9_-' '-' \
    | sed -e 's/^[^a-z]*//' -e 's/-*$//' \
    | cut -c1-32 \
    | sed -e 's/-*$//'
}

# Fed by a heredoc rather than a pipe: a piped `while` runs in a subshell, where
# rc is set and then thrown away, and the loop would always report success.
rc=0
while IFS='	' read -r pane_id agent session_id current; do
  [ -n "$pane_id" ] || continue

  # Only Claude publishes a user-settable session name to a file this can read.
  # Codex sessions carry an id here too, but nothing on the other end of it to
  # read a name out of — so they are skipped by kind rather than by a failed
  # lookup, which would be indistinguishable from a broken Claude install.
  if [ "$agent" != "claude" ]; then
    [ "$dry" = 1 ] && say "$pane_id	skip	$agent has no session name"
    continue
  fi

  row=$(printf '%s\n' "$sessions" | awk -F'\t' -v s="$session_id" '$1 == s { print; exit }')
  if [ -z "$row" ]; then
    [ "$dry" = 1 ] && say "$pane_id	skip	no session file for $session_id"
    continue
  fi

  name=$(printf '%s' "$row"  | cut -f2)
  source=$(printf '%s' "$row" | cut -f3)
  cwd=$(printf '%s' "$row"   | cut -f4)

  if [ -z "$name" ]; then
    [ "$dry" = 1 ] && say "$pane_id	skip	session has no name"
    continue
  fi

  # The field, when Claude writes it.
  if [ "$source" = derived ]; then
    [ "$dry" = 1 ] && say "$pane_id	skip	$name is Claude's seeded name"
    continue
  fi

  # The fallback, for a Claude that predates the field: rebuild the seed from
  # the session's own cwd rather than pattern-matching it, so a name a human
  # chose that happens to end in two hex digits still syncs.
  if [ -z "$source" ] && [ -n "$cwd" ]; then
    stem=$(basename "$cwd" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')
    stem=${stem%-}
    case "$name" in
      "$stem"-[0-9a-f][0-9a-f])
        [ "$dry" = 1 ] && say "$pane_id	skip	$name looks like Claude's seeded name"
        continue ;;
    esac
  fi

  slug=$(slugify "$name")
  if [ -z "$slug" ]; then
    [ "$dry" = 1 ] && say "$pane_id	skip	$name has no slug herdr would accept"
    continue
  fi

  if [ "$slug" = "$current" ]; then
    [ "$dry" = 1 ] && say "$pane_id	ok	already $slug"
    continue
  fi

  if [ "$dry" = 1 ]; then
    say "$pane_id	rename	${current:--} -> $slug"
    continue
  fi

  # A failure here is nearly always a name another pane already holds — two
  # checkouts of one repo renamed the same thing. Reported, never fatal: the
  # hook runs on every status change and one unnameable pane must not stop the
  # rest of the grid from getting named.
  # </dev/null because this loop's stdin is the roster heredoc, and a child that
  # reads stdin would eat the panes we have not visited yet.
  if herdr agent rename "$pane_id" "$slug" >/dev/null 2>&1 </dev/null; then
    say "$pane_id	renamed	$slug"
  else
    [ "$quiet" = 1 ] || printf 'herdr-agent-name: %s: herdr refused the name %s\n' "$pane_id" "$slug" >&2
    rc=1
  fi
done <<ROSTER
$roster
ROSTER

exit $rc
