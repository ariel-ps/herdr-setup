#!/bin/sh
# herdr-whoami — print the name of the herdr pane this process is running in.
#
# For an agent asking "who am I in this herd?". Exists as an executable rather
# than a shell function because the callers are agents shelling out with
# `sh -c`, not interactive zsh, and a function in shell/herdr.sh is not
# reachable from a non-interactive shell that never sourced it.
#
#   herdr-whoami                 # reviewer
#   herdr-whoami --all           # every identifier and which one won
#   herdr-whoami --json          # the whole resolved record
#   herdr-whoami --pane w1:p3    # ask about a different pane
#
# There is no single "name" field in herdr, which is the whole reason this
# script is more than a jq one-liner. A pane carries three that can each be
# empty, set independently, and disagree — the same pane will answer "winarch"
# for label, "harden-manager" for agent name and whatever the agent last wrote
# for title. So they are tried in order of how addressable each one is:
#
#   1. agent name   (`herdr agent rename`) — what `herdr agent prompt` accepts,
#                   so a name that resolves here can be messaged back.
#   2. pane label   (`herdr pane rename`)  — stable, but not an agent handle.
#   3. terminal title — always populated and the string a human reads off the
#                   tab bar, but volatile: Claude Code and Codex rewrite it
#                   from their own hooks, so it can change mid-session to an
#                   auto-generated topic. Last resort before the raw id.
#   4. pane id      — never empty, never meaningful.
#
# The pane comes from $HERDR_PANE_ID, which herdr injects into every managed
# pane. `herdr pane current` resolves it the same way and is used directly, so
# an unfocused pane still gets its own answer rather than the focused one's.

set -u

usage() {
  cat >&2 <<'EOF'
usage: herdr-whoami [--all|-a] [--json|-j] [--pane <pane-id>] [--quiet|-q]

  (no flags)        print the resolved name
  --all, -a         print every identifier, marking the one that resolved
  --json, -j        print the resolved record as JSON
  --pane <id>       resolve for that pane instead of this one
  --quiet, -q       exit 0/1 with no output; for `if herdr-whoami -q; then`
EOF
}

mode=name
pane="${HERDR_PANE_ID:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --all|-a)   mode=all ;;
    --json|-j)  mode=json ;;
    --quiet|-q) mode=quiet ;;
    --pane)     shift; [ $# -gt 0 ] || { echo "herdr-whoami: --pane needs a pane id" >&2; exit 2; }; pane="$1" ;;
    --pane=*)   pane="${1#--pane=}" ;;
    -h|--help)  usage; exit 0 ;;
    *)          echo "herdr-whoami: unknown option: $1" >&2; usage; exit 2 ;;
  esac
  shift
done

die() { [ "$mode" = quiet ] || echo "herdr-whoami: $1" >&2; exit 1; }

[ "${HERDR_ENV:-}" = 1 ] || [ -n "$pane" ] || die "not running inside herdr (HERDR_ENV unset)"
[ -n "$pane" ] || die "HERDR_PANE_ID is unset; pass --pane <id>"
command -v herdr >/dev/null 2>&1 || die "herdr not on PATH"
command -v jq >/dev/null 2>&1 || die "jq not found"

# Two calls because the identifiers live in two places: `pane current`/`pane
# list` never carries the agent name, and `agent list` never carries the pane
# label. The agent call is allowed to fail — a pane with no agent in it is a
# normal shell, not an error.
pane_json=$(herdr pane list 2>/dev/null | jq -c --arg p "$pane" \
  '.result.panes[]? | select(.pane_id == $p)') || pane_json=
[ -n "$pane_json" ] || die "no pane $pane (is the server running?)"

agent_json=$(herdr agent list 2>/dev/null | jq -c --arg p "$pane" \
  '.result.agents[]? | select(.pane_id == $p)') || agent_json=
[ -n "$agent_json" ] || agent_json='{}'

# Empty strings are treated as unset alongside null: herdr clears a label to ""
# rather than removing the key, and an empty name is not an answer.
record=$(printf '%s\n%s\n' "$pane_json" "$agent_json" | jq -s -c '
  def clean: if . == null or . == "" then null else . end;
  .[0] as $p | .[1] as $a
  | {
      pane_id:    $p.pane_id,
      agent_name: ($a.name              | clean),
      label:      ($p.label             | clean),
      title:      ($p.terminal_title_stripped | clean),
      agent:      ($p.agent             | clean),
      status:     ($p.agent_status      | clean),
      session:    ($p.agent_session.value | clean),
      workspace:  $p.workspace_id,
      tab:        $p.tab_id
    }
  | . + (
      if   .agent_name then {name: .agent_name, source: "agent_name"}
      elif .label      then {name: .label,      source: "label"}
      elif .title      then {name: .title,      source: "title"}
      else                  {name: .pane_id,    source: "pane_id"}
      end
    )')

case "$mode" in
  quiet) printf '%s' "$record" | jq -e '.source != "pane_id"' >/dev/null 2>&1 ;;
  json)  printf '%s\n' "$record" | jq . ;;
  name)  printf '%s\n' "$record" | jq -r '.name' ;;
  all)
    printf '%s\n' "$record" | jq -r '
      def row($k; $v): "\(if $k == .source then "*" else " " end) \($k)\t\($v // "-")";
      [ row("agent_name"; .agent_name),
        row("label";      .label),
        row("title";      .title),
        row("pane_id";    .pane_id),
        "",
        "  resolved\t\(.name)  (from \(.source))",
        "  agent\t\(.agent // "-") \(.status // "")",
        "  session\t\(.session // "-")",
        "  where\t\(.workspace)  \(.tab)  \(.pane_id)"
      ] | .[]' | column -t -s "$(printf '\t')"
    ;;
esac
