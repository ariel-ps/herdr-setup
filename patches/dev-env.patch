+
+# Completion for `agents` (bin/agents). Targets are completed from the live
+# roster, not a static list — what is running is exactly what you cannot know in
+# advance, and it is different every time you tab.
+__agents_complete() {
+  local -a subcmds
+  subcmds=(
+    'ls:list the agents running in kitty panes'
+    'send:send a message to one agent'
+    'read:read one agent'\''s latest reply'
+    'roles:send one role brief per agent, in bulk'
+  )
+
+  if (( CURRENT == 2 )); then
+    _describe -t commands 'agents command' subcmds
