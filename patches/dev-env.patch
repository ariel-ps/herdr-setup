+# aoe-grid-attach [filter] — tile the aoe sessions that are ALREADY running
+# into one new kitty tab, one pane each, grid layout. The read-only companion
+# to aoe-grid-claude-danger: that one creates sessions, this one only gives
+# existing ones a wall to live on, so it's safe to re-run any time.
+#
+# Session set comes from `aoe ps` (the in-flight runtime view), not `aoe list`
+# — `list` reports rows as `live` that have no tmux process behind them any
+# more, and attaching to those just errors in a pane. Optional <filter> is a
+# case-insensitive substring match on the session title.
+#
+# usage: aoe-grid-attach          # every in-flight tmux session
+#        aoe-grid-attach proe     # only titles containing "proe"
+#
+# Re-running opens ANOTHER tab attached to the same sessions; tmux allows it,
+# but every client shares the session's view and its size clamps to the
+# smallest one, so close the old tab rather than stacking walls.
+aoe-grid-attach() {
+  local filter="${1:-}"
+  command -v aoe >/dev/null 2>&1 \
+    || { echo "aoe-grid-attach: aoe not found" >&2; return 1; }
+  kitty @ ls >/dev/null 2>&1 \
+    || { echo "aoe-grid-attach: kitty remote control unavailable (enable allow_remote_control in kitty.conf)" >&2; return 1; }
+
+  # Titles live in `aoe list`, runtime state in `aoe ps`, and they key on the
+  # same session id — so pass both blobs to one python and join there.
+  local ps_json list_json
+  ps_json=$(aoe ps --json 2>/dev/null) || ps_json=""
+  list_json=$(aoe list --json 2>/dev/null) || list_json="[]"
+  [[ -n "$ps_json" ]] \
+    || { echo "aoe-grid-attach: could not read \`aoe ps --json\`" >&2; return 1; }
+
+  # `uv run --no-project python`, not python3: an env guard in this repo blocks
+  # the bare interpreter (see AGENTS.md).
+  local -a rows
+  rows=("${(@f)$(printf '%s' "$ps_json" | uv run --no-project python -c '
+import json, sys
+
+ps = json.load(sys.stdin)
+titles = {s["id"]: (s.get("title") or s["id"]) for s in json.loads(sys.argv[1])}
+filt = sys.argv[2].lower()
+skipped = []
+for row in ps:
+    sid = row.get("session", "")
+    title = titles.get(sid, sid[:8])
+    if row.get("substrate") != "tmux":
+        # ACP structured-view workers have no tmux pane to attach to.
+        skipped.append(title + " (" + str(row.get("substrate", "?")) + ")")
+        continue
+    if filt and filt not in title.lower():
+        continue
+    print(f"{sid}\t{title}")
+if skipped:
+    print("SKIP\t" + ", ".join(skipped))
+' "$list_json" "$filter")}")
+  rows=("${(@)rows:#}")
+
+  local skipped=""
+  local -a keep
+  local r
+  for r in "${rows[@]}"; do
+    if [[ "$r" == "SKIP"$'\t'* ]]; then skipped="${r#*$'\t'}"; else keep+=("$r"); fi
+  done
+  [[ -n "$skipped" ]] && echo "aoe-grid-attach: skipped non-tmux sessions: $skipped" >&2
+
+  (( ${#keep[@]} )) \
+    || { echo "aoe-grid-attach: no in-flight tmux sessions${filter:+ matching \"$filter\"}" >&2; return 1; }
+
+  # `zsh -lic` for the same reason as aoe-grid-claude-danger: a kitty-launched
+  # process inherits kitty's minimal PATH, and only a LOGIN shell picks up
+  # /opt/homebrew/bin (so aoe can find tmux). `|| exec zsh` keeps a failed
+  # attach's error on screen instead of the pane vanishing.
+  local first_id="" id title
+  local -i n=0
+  for r in "${keep[@]}"; do
+    id="${r%%$'\t'*}"
+    title="${r#*$'\t'}"
+    if (( n == 0 )); then
+      first_id=$(kitty @ launch --type=tab --tab-title="aoe-grid" --cwd=current \
+        --title "$title" -- zsh -lic "aoe session attach ${(q)id} || exec zsh") \
+        || { echo "aoe-grid-attach: failed to launch tab" >&2; return 1; }
+    else
+      kitty @ launch --match "window_id:$first_id" --cwd=current \
+        --title "$title" -- zsh -lic "aoe session attach ${(q)id} || exec zsh" >/dev/null
+    fi
+    (( n++ ))
+  done
+
+  kitty @ goto-layout --match "window_id:$first_id" grid
+  echo "aoe-grid-attach: ${n} pane(s), new tab, grid layout"
+}
+
