diff --git a/scripts/ai/agents/batching-metrics.sh b/scripts/ai/agents/batching-metrics.sh
new file mode 100644
index 0000000000000000000000000000000000000000..dea81f5d7a0f1545895e76c3f3385f198338a4ac
--- /dev/null
+++ b/scripts/ai/agents/batching-metrics.sh
@@ -0,0 +1,128 @@
+# Batching-policy effect measurement - sourced by init.zsh
+#
+# Measures what the ~/.claude/CLAUDE.md batching policy targets. Three metrics,
+# because agents batch through two different mechanisms and only one of them is
+# visible as parallel tool_use blocks:
+#
+#   parallel%   share of tool-issuing turns emitting 2+ tool_use blocks
+#   ops/turn    logical operations per turn - counts shell chaining (`a && b; c`)
+#               inside a single Bash call, which parallel% cannot see
+#   cd%         share of Bash calls opening with `cd `
+#
+# Baseline captured 2026-09-16, before the policy existed:
+#   parallel 0.002%   ops/turn 3.07   cd 43.9%   (47,037 turns, 32,314 Bash calls)
+
+__batching_metrics_py() {
+  cat <<'PY'
+import json, pathlib, sys, re, collections
+
+since = sys.argv[1] if len(sys.argv) > 1 else "0000-00-00"
+until = sys.argv[2] if len(sys.argv) > 2 else "9999-99-99"
+only  = sys.argv[3] if len(sys.argv) > 3 else ""
+
+HEREDOC = re.compile(r"<<-?\s*'?\"?([A-Za-z_][A-Za-z0-9_]*)'?\"?[\s\S]*?^\1\s*$", re.M)
+
+def segments(cmd):
+    """Logical operations in one shell command. Heredoc bodies and quoted
+    spans are stripped first so separators inside them don't inflate the count."""
+    s = HEREDOC.sub(" ", cmd)
+    out, quote, prev = [], None, ""
+    for ch in s:
+        if quote:
+            if ch == quote and prev != "\\":
+                quote = None
+            prev = ch
+            continue
+        if ch in "'\"":
+            quote = ch
+        out.append(ch)
+        prev = ch
+    stripped = "".join(out)
+    parts = re.split(r"&&|\|\||;|\n", stripped)
+    return max(1, sum(1 for p in parts if p.strip()))
+
+base = pathlib.Path.home() / ".claude/projects"
+files = [pathlib.Path(only)] if only else list(base.rglob("*.jsonl"))
+
+turns = parallel = ops = bash = cd_bash = 0
+per_day = collections.defaultdict(lambda: [0, 0, 0, 0, 0])
+
+for f in files:
+    try:
+        raw = f.read_text(errors="replace")
+    except OSError:
+        continue
+    for line in raw.splitlines():
+        if not line.startswith("{"):
+            continue
+        try:
+            o = json.loads(line)
+        except ValueError:
+            continue
+        if (o.get("type") or (o.get("message") or {}).get("role")) != "assistant":
+            continue
+        day = (o.get("timestamp") or "")[:10]
+        if not only and not (since <= day <= until):
+            continue
+        blocks = [b for b in ((o.get("message") or {}).get("content") or [])
+                  if isinstance(b, dict) and b.get("type") == "tool_use"]
+        if not blocks:
+            continue
+        turns += 1
+        d = per_day[day]
+        d[0] += 1
+        if len(blocks) > 1:
+            parallel += 1
+            d[1] += 1
+        turn_ops = 0
+        for b in blocks:
+            if b.get("name") == "Bash":
+                cmd = (b.get("input") or {}).get("command", "")
+                bash += 1
+                d[3] += 1
+                turn_ops += segments(cmd)
+                if cmd.lstrip().startswith("cd "):
+                    cd_bash += 1
+                    d[4] += 1
+            else:
+                turn_ops += 1
+        ops += turn_ops
+        d[2] += turn_ops
+
+if not turns:
+    print(f"no tool-issuing turns in range {since}..{until}")
+    sys.exit(0)
+
+label = pathlib.Path(only).name[:8] if only else f"{since} .. {until}"
+print(f"scope             {label}")
+print(f"tool-issuing turns  {turns:,}")
+print(f"parallel turns      {parallel:,}  ({parallel/turns*100:.3f}%)   baseline 0.002%")
+print(f"logical ops         {ops:,}  ({ops/turns:.2f} per turn)   baseline 3.07")
+if bash:
+    print(f"Bash calls          {bash:,}")
+    print(f"  cd-prefixed       {cd_bash:,}  ({cd_bash/bash*100:.1f}%)   baseline 43.9%")
+if only:
+    sys.exit(0)
+print()
+print("day         turns  par%  ops/turn   bash   cd%")
+for dd in sorted(per_day)[-14:]:
+    t, p, o_, b, c = per_day[dd]
+    print(f"{dd}  {t:6d}  {p/t*100:5.2f}     {o_/t:5.2f}  {b:5d}  {(c/b*100 if b else 0):5.1f}")
+PY
+}
+
+# batching-metrics [since] [until] - ISO dates, e.g. batching-metrics 2026-09-17
+batching-metrics() {
+  printf '%s' "$(__batching_metrics_py)" | uv run python - "${1:-0000-00-00}" "${2:-9999-99-99}"
+}
+
+# batching-session <path-to.jsonl> - measure one transcript in isolation
+batching-session() {
+  [[ -f "$1" ]] || { echo "batching-session: no such transcript: $1" >&2; return 1; }
+  printf '%s' "$(__batching_metrics_py)" | uv run python - "" "" "$1"
+}
+
+# batching-baseline        - the pre-policy window, frozen for comparison
+# batching-since-policy    - everything after the policy landed
+batching-baseline()     { batching-metrics 0000-00-00 2026-09-16; }
+batching-since-policy() { batching-metrics 2026-09-17; }
diff --git a/scripts/ai/agents/claude-clean.sh b/scripts/ai/agents/claude-clean.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c5ddbc60bcc71a92b681410d272add186bb02356
--- /dev/null
+++ b/scripts/ai/agents/claude-clean.sh
@@ -0,0 +1,56 @@
+# Clean Claude Code in a container - sourced by init.zsh
+#
+# `claude --safe-mode` already disables skills, plugins, hooks and CLAUDE.md,
+# but it still runs on this machine against this filesystem. The container is
+# for the other half of the problem: an untrusted repo that should not reach
+# the host at all.
+#
+# Auth and session history live in the docker volume claude-clean-home, never
+# in ~/.claude. The container has its own login and its own transcripts, and
+# `docker volume rm claude-clean-home` throws both away.
+#
+# Image source: $CLAUDE_CLEAN_CONTEXT/Dockerfile (built on first use).
+
+: ${CLAUDE_CLEAN_IMAGE:=claude-clean}
+: ${CLAUDE_CLEAN_VOLUME:=claude-clean-home}
+: ${CLAUDE_CLEAN_CONTEXT:=$HOME/Documents/projects/claude-clean}
+
+# claude-clean-build - rebuild the image (do this to pick up a newer Claude).
+claude-clean-build() {
+  [ -f "$CLAUDE_CLEAN_CONTEXT/Dockerfile" ] \
+    || { echo "claude-clean-build: no Dockerfile at $CLAUDE_CLEAN_CONTEXT" >&2; return 1; }
+  docker build -t "$CLAUDE_CLEAN_IMAGE" "$CLAUDE_CLEAN_CONTEXT"
+}
+
+# claude-clean [claude args...] - Claude Code in a container, on $PWD.
+#   claude-clean                      # interactive; first run needs /login
+#   claude-clean -p "review this"     # headless, works without a tty
+#   claude-clean --safe-mode          # also ignore the repo's own .claude/
+claude-clean() {
+  command -v docker >/dev/null 2>&1 || { echo "claude-clean: docker not found on PATH" >&2; return 1; }
+  docker info >/dev/null 2>&1 || { echo "claude-clean: docker daemon down - run: colima start" >&2; return 1; }
+
+  # Colima only shares $HOME into the VM. A workdir outside it does not fail,
+  # it mounts an EMPTY directory and the container quietly sees no code at all,
+  # so refuse rather than hand back a confidently wrong answer about nothing.
+  case "$PWD" in
+    "$HOME"|"$HOME"/*) ;;
+    *) echo "claude-clean: $PWD is outside \$HOME - colima does not share it, the container would see an empty dir" >&2; return 1 ;;
+  esac
+
+  docker image inspect "$CLAUDE_CLEAN_IMAGE" >/dev/null 2>&1 || claude-clean-build || return 1
+
+  # -t against a pipe makes docker refuse outright ("stdin is not a terminal"),
+  # which is what breaks `claude-clean -p ...` from scripts and from Claude's
+  # own `!` prefix. Only ask for a tty when there is one.
+  local -a tty
+  [ -t 0 ] && tty=(-i -t) || tty=(-i)
+
+  # $PWD is mirrored rather than mounted at a fixed /work so that Claude's
+  # per-project session directory keys off the real path; every repo mounted at
+  # /work would otherwise share one transcript folder.
+  docker run "${tty[@]}" --rm \
+    -v "$CLAUDE_CLEAN_VOLUME:/home/node/.claude" \
+    -v "$PWD:$PWD" -w "$PWD" \
+    "$CLAUDE_CLEAN_IMAGE" "$@"
+}
