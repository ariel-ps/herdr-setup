@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""Bulk-import Claude Code transcripts into Xirp/Chirp as managed sessions.
+
+`xirp session import` handles one session at a time and defaults to the one in
+the current terminal, but it accepts an explicit harness + id + cwd, so any past
+transcript can be replayed through it. This walks ~/.claude/projects and does
+that for each one, recording successes in a ledger so re-runs only pick up
+what is new.
+"""
+import argparse
+import glob
+import json
+import os
+import shutil
+import subprocess
+import sys
+
+PROJECTS = os.path.expanduser("~/.claude/projects")
+LEDGER = os.path.expanduser("~/.chirp/imported-claude-sessions.txt")
+HOME = os.path.realpath(os.path.expanduser("~"))
+EPHEMERAL = ("/private/tmp", "/tmp", "/var/folders")
+SCAN_LINES = 500
+
+
+def find_cli():
+    for name in ("xirp", "chirp-core", "chirp"):
+        p = shutil.which(name)
+        if p:
+            return p
+    p = os.path.expanduser("~/.local/bin/xirp")
+    return p if os.path.exists(p) else None
+
+
+def transcript_meta(path):
+    """First cwd and first real user message, from the head of a transcript."""
+    cwd = text = None
+    try:
+        with open(path, errors="replace") as fh:
+            for n, line in enumerate(fh):
+                if n > SCAN_LINES or (cwd and text):
+                    break
+                try:
+                    o = json.loads(line)
+                except ValueError:
+                    continue
+                if cwd is None:
+                    cwd = o.get("cwd")
+                if text is None and o.get("type") == "user":
+                    c = (o.get("message") or {}).get("content")
+                    if isinstance(c, list):
+                        c = " ".join(p.get("text", "") for p in c if isinstance(p, dict))
+                    if isinstance(c, str):
+                        s = " ".join(c.split())
+                        if s and not s.startswith(("/", "<")):
+                            text = s
+    except OSError:
+        pass
+    return cwd, text
+
+
+def session_name(cwd, text, sid):
+    base = os.path.basename(cwd.rstrip("/")) or "home"
+    return f"{base} · {text[:58]}" if text else f"{base} · Claude {sid[:8]}"
+
+
+def build_queue(scope, done):
+    """Top-level transcripts only; nested subagents/ and wf_* are not sessions."""
+    files = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
+    files.sort(key=os.path.getmtime, reverse=True)
+    queue, skipped = [], {"done": 0, "no-cwd": 0, "gone": 0, "ephemeral": 0, "home": 0}
+    for f in files:
+        sid = os.path.basename(f)[:-6]
+        if sid in done:
+            skipped["done"] += 1
+            continue
+        cwd, text = transcript_meta(f)
+        if not cwd:
+            skipped["no-cwd"] += 1
+        elif cwd.startswith(EPHEMERAL):
+            skipped["ephemeral"] += 1
+        elif not os.path.isdir(cwd):
+            skipped["gone"] += 1
+        elif scope == "projects" and os.path.realpath(cwd) == HOME:
+            skipped["home"] += 1
+        else:
+            queue.append((sid, cwd, session_name(cwd, text, sid)))
+    return queue, skipped
+
+
+def main():
+    ap = argparse.ArgumentParser(prog="xirp-import-all")
+    ap.add_argument("--scope", choices=["projects", "all"], default="projects",
+                    help="projects (default) skips sessions run from $HOME")
+    ap.add_argument("--dry-run", action="store_true", help="list what would be imported")
+    ap.add_argument("--limit", type=int, default=0)
+    args = ap.parse_args()
+
+    cli = find_cli()
+    if not cli:
+        sys.exit("xirp-import-all: no xirp/chirp CLI on PATH")
+    if not os.path.isdir(PROJECTS):
+        sys.exit(f"xirp-import-all: {PROJECTS} not found")
+
+    done = set()
+    if os.path.exists(LEDGER):
+        with open(LEDGER) as fh:
+            done = {l.strip() for l in fh if l.strip()}
+
+    queue, skipped = build_queue(args.scope, done)
+    if args.limit:
+        queue = queue[: args.limit]
+
+    counts = " ".join(f"{k}={v}" for k, v in skipped.items() if v)
+    print(f"scope={args.scope} queued={len(queue)} skipped: {counts or 'none'}")
+    if not queue:
+        return
+    if args.dry_run:
+        for sid, cwd, name in queue:
+            print(f"  {cwd}\n    {name}")
+        return
+
+    os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
+    ok = fail = 0
+    try:
+        with open(LEDGER, "a") as ledger:
+            for i, (sid, cwd, name) in enumerate(queue, 1):
+                r = subprocess.run(
+                    [cli, "session", "import", "claude", sid,
+                     "--cwd", cwd, "--name", name, "--json"],
+                    capture_output=True, text=True, timeout=180,
+                )
+                if r.returncode == 0:
+                    ok += 1
+                    ledger.write(sid + "\n")
+                    ledger.flush()
+                    print(f"[{i}/{len(queue)}] ok   {name}")
+                else:
+                    fail += 1
+                    err = (r.stderr or r.stdout).strip().splitlines()
+                    print(f"[{i}/{len(queue)}] FAIL {sid}: {err[-1] if err else '?'}",
+                          file=sys.stderr)
+    except KeyboardInterrupt:
+        print("\ninterrupted; ledger is current, re-run to resume", file=sys.stderr)
+    print(f"imported={ok} failed={fail} ledger={LEDGER}")
+    sys.exit(1 if fail else 0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/ai/xirp/xirp.sh b/scripts/ai/xirp/xirp.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5c20242309441612450f60eb7077a3a24d76c9b3
--- /dev/null
+++ b/scripts/ai/xirp/xirp.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env zsh
+# Xirp/Chirp desktop — bulk session import.
+#
+# The packaged `xirp` CLI imports one session at a time and assumes it is the
+# one in the current terminal. These wrap bin/xirp-import-all.py, which replays
+# every ~/.claude/projects transcript through `xirp session import` instead.
+# A ledger at ~/.chirp/imported-claude-sessions.txt makes re-runs incremental,
+# so this is safe to call repeatedly (and safe to interrupt).
+#
+#   xirp-import-all                 # import every project session not yet in Xirp
+#   xirp-import-all --dry-run       # list them without importing
+#   xirp-import-all --scope all     # include sessions run from $HOME
+#   xirp-import-status              # how many are imported vs pending
+
+__xirp_bin() { print -r -- "${DEV_ENV_ROOT:-$HOME/Documents/projects/dev-env}/scripts/ai/xirp/bin"; }
+
+__xirp_py() {
+  command -v python3 >/dev/null 2>&1 || { echo "xirp: python3 not found" >&2; return 1; }
+  python3 "$(__xirp_bin)/$1" "${@:2}"
+}
+
+# usage: xirp-import-all [--scope projects|all] [--dry-run] [--limit N]
+#   Imports each Claude Code session as a stopped, resumable Xirp session named
+#   after its first user message. Default scope skips sessions whose working
+#   directory was $HOME itself, since those are ad-hoc chats with no project.
+xirp-import-all() { __xirp_py xirp-import-all.py "$@"; }
+
+# usage: xirp-import-status
+#   Ledger count against what a --scope all dry run still finds pending.
+xirp-import-status() {
+  local ledger="$HOME/.chirp/imported-claude-sessions.txt"
+  echo "imported: $([ -f "$ledger" ] && wc -l < "$ledger" | tr -d ' ' || echo 0)"
+  __xirp_py xirp-import-all.py --scope all --dry-run | head -1
+}
