diff --git a/scripts/infra/zscaler/README.md b/scripts/infra/zscaler/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..c4335907faef9efd3b2acc5262d6b95eefe1d6d6
--- /dev/null
+++ b/scripts/infra/zscaler/README.md
@@ -0,0 +1,37 @@
+# zscaler
+
+Quit **Zscaler** from the terminal and confirm it actually stopped.
+
+## Commands
+
+| command          | what it does                                              |
+|------------------|-------------------------------------------------------------|
+| `zscaler-off`    | quit the GUI app; force-kills `ZscalerService`/`ZscalerTunnel` if either survives the quit |
+| `zscaler-status` | list any zscaler processes currently running                |
+
+```sh
+zscaler-status
+zscaler-off
+zscaler-status   # confirm
+```
+
+## Why this exists
+
+Quitting Zscaler from the menu bar only asks the GUI app to exit.
+`ZscalerService` and `ZscalerTunnel` are separate background daemons that can
+keep running — and keep intercepting traffic — after the GUI is gone.
+
+That mattered in practice: Zscaler was silently routing DNS for an EKS private
+endpoint through a broken app-segment, while every other HTTPS host worked
+fine, which looked exactly like a flaky AWS Client VPN. Confirming Zscaler is
+*actually* fully down (not just "the icon is gone") is what separated the two
+faults.
+
+## Notes / gotchas
+
+- Placed under `infra`, not `mac`, on the same reasoning as `aws-vpn`: it
+  exists to make remote things reachable (or, here, to get out of the way so
+  another VPN can). See `../README.md`.
+- `zscaler-off` doesn't attempt to reopen Zscaler — that's a manual
+  `open -a Zscaler` if you need it back, since re-enabling corp security
+  tooling isn't something a script should default to doing quietly.
diff --git a/scripts/infra/zscaler/zscaler.sh b/scripts/infra/zscaler/zscaler.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4d4e8531bb816dd0602e74c783526fd083daeed4
--- /dev/null
+++ b/scripts/infra/zscaler/zscaler.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env zsh
+# Zscaler — quit-and-confirm helper, sourced by init.zsh.
+#
+# Quitting the menu-bar app only asks the GUI to exit; ZscalerService and
+# ZscalerTunnel are background daemons that can keep running (and keep
+# intercepting traffic) after that. Confirmed live: it silently DNS-routed an
+# EKS private endpoint through a broken app-segment while every other HTTPS
+# host worked fine, which cost real time to trace before the fix turned out
+# to be "close Zscaler," not "fix the VPN."
+#
+#   zscaler-off      quit the GUI, then confirm (and force, if needed) that no
+#                    zscaler process is left running
+#   zscaler-status   list any zscaler processes currently running
+
+zscaler-status() {
+  local procs
+  procs="$(pgrep -fli zscaler 2>/dev/null)"
+  if [[ -z "$procs" ]]; then
+    print -r -- "zscaler: not running"
+    return 1
+  fi
+  print -r -- "zscaler: running"
+  print -r -- "$procs"
+  return 0
+}
+
+zscaler-off() {
+  osascript -e 'tell application "Zscaler" to quit' >/dev/null 2>&1
+  local i
+  for i in 1 2 3 4 5; do
+    pgrep -fi zscaler >/dev/null 2>&1 || { print -r -- "zscaler: closed"; return 0; }
+    sleep 1
+  done
+  # GUI quit didn't take the background daemons down with it — force them.
+  pkill -fi zscaler 2>/dev/null
+  sleep 1
+  if pgrep -fi zscaler >/dev/null 2>&1; then
+    print -r -- "zscaler: still running after force-quit:"
+    pgrep -fli zscaler
+    return 1
+  fi
+  print -r -- "zscaler: closed (force-quit required)"
+}
diff --git a/scripts/mac/doctor/doctor.sh b/scripts/mac/doctor/doctor.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c2d08ac65ea436d46ef64163369bbc1be4721234
--- /dev/null
+++ b/scripts/mac/doctor/doctor.sh
@@ -0,0 +1,89 @@
+# dev-env-doctor — repair the files endpoint security deletes from this machine.
+#
+# SentinelOne sweeps the home directory and removes thin launcher scripts,
+# never the binaries they exec, leaving the parent directory behind. Nothing
+# announces it and the symptom never looks like antivirus: brew stops existing,
+# a Claude session fails its SessionStart hooks, ~/.zshrc errors on a missing
+# command. The tool that repairs it is a Python package in its own checkout;
+# what follows is only the shell entry point.
+#
+# dev-env-doctor-check is the one wired into ~/.zshrc. It stats the manifest the
+# doctor writes rather than asking Python anything, so a healthy machine starts
+# no interpreter at all — Python is spawned only once a guarded file is gone.
+
+dev-env-doctor() {
+  local bin repo py
+  bin=$(whence -p dev-env-doctor 2>/dev/null)
+  if [[ -n "$bin" ]]; then
+    "$bin" "$@"
+    return
+  fi
+
+  # The console script lives in ~/.local/bin, which is one of the places things
+  # get deleted from, so the checkout has to work as a fallback.
+  repo="${DEV_ENV_DOCTOR_ROOT:-$HOME/Documents/projects/dev-env-doctor}"
+  if [[ ! -d "$repo/src/dev_env_doctor" ]]; then
+    echo "dev-env-doctor: not on PATH and no checkout at $repo" >&2
+    return 1
+  fi
+
+  py=$(whence -p python3 2>/dev/null)
+  if [[ -z "$py" ]]; then
+    echo "dev-env-doctor: python3 not found" >&2
+    return 1
+  fi
+
+  PYTHONPATH="$repo/src" "$py" -m dev_env_doctor "$@"
+}
+
+# Cheap enough to run on every shell: no forks, no interpreter, just stat.
+dev-env-doctor-check() {
+  local manifest line saved_path broken=0
+  manifest="${XDG_CACHE_HOME:-$HOME/.cache}/dev-env-doctor/watch.list"
+
+  if [[ ! -r "$manifest" ]]; then
+    dev-env-doctor manifest >/dev/null 2>&1
+    return 0
+  fi
+
+  while IFS= read -r line; do
+    if [[ -n "$line" && ! -e "$line" ]]; then
+      broken=1
+      break
+    fi
+  done < "$manifest"
+
+  (( broken )) || return 0
+
+  # The repairs shell out to git, herdr and friends. /opt/homebrew/bin can be
+  # missing from PATH *because* brew was what got deleted — the shellenv block
+  # at the top of ~/.zshrc fails silently in that case — so put it back for the
+  # repair itself rather than letting every homebrew tool look uninstalled.
+  saved_path="$PATH"
+  if [[ -d /opt/homebrew/bin && ":$PATH:" != *":/opt/homebrew/bin:"* ]]; then
+    PATH="/opt/homebrew/bin:$PATH"
+  fi
+  dev-env-doctor repair --quiet
+  PATH="$saved_path"
+
+  # If brew is what came back, this shell still has no idea it exists.
+  if [[ -x /opt/homebrew/bin/brew && ":$PATH:" != *":/opt/homebrew/bin:"* ]]; then
+    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
+  fi
+}
+
+__dev_env_doctor_completion() {
+  local -a commands
+  commands=(
+    'status:show what is broken'
+    'repair:fix broken targets'
+    'select:pick what to repair from a menu'
+    'list:show every known target'
+    'manifest:rewrite the path list zsh watches'
+  )
+  _describe 'command' commands
+}
+
+# compinit may not have run yet depending on where init.zsh sits in ~/.zshrc,
+# and an ungated compdef is an error at source time.
+(( $+functions[compdef] )) && compdef __dev_env_doctor_completion dev-env-doctor
diff --git a/scripts/mac/vm/bin/vpn-dns-proxy.py b/scripts/mac/vm/bin/vpn-dns-proxy.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1be59720b874c2562f818f555c52a8ed095e14e
--- /dev/null
+++ b/scripts/mac/vm/bin/vpn-dns-proxy.py
@@ -0,0 +1,62 @@
+"""Minimal UDP DNS forwarder for a VM behind a corp VPN.
+
+Why this exists: an AWS VPN client's resolver listens on the tunnel's *own*
+address (e.g. 100.64.0.1). A VM NAT'd through that tunnel cannot use it — NAT
+the query and it arrives from the resolver's own address and loops; skip the
+NAT and the resolver ignores the foreign source. Either way the VM can't
+resolve internal split-horizon names.
+
+The host, however, queries that resolver fine. So bind here on the VM-facing
+bridge address and relay. The VM points its DNS at the host and gets correct
+answers for internal names (.sentinelone.net, .s1.guru, .s1infra.com …) and
+public ones alike, with no /etc/hosts pinning — those internal addresses are
+reassigned by the VPN and cannot be hardcoded.
+
+Needs root to bind port 53.
+
+    LISTEN_HOST / LISTEN_PORT / UPSTREAM_HOST / UPSTREAM_PORT override the
+    defaults via the environment (the `vm` dev-env profile sets these).
+"""
+
+import os
+import socket
+import threading
+
+LISTEN_HOST = os.environ.get("VM_DNS_LISTEN_HOST", "192.168.65.1")
+LISTEN_PORT = int(os.environ.get("VM_DNS_LISTEN_PORT", "53"))
+UPSTREAM_HOST = os.environ.get("VM_DNS_UPSTREAM_HOST", "100.64.0.1")
+UPSTREAM_PORT = int(os.environ.get("VM_DNS_UPSTREAM_PORT", "53"))
+TIMEOUT = float(os.environ.get("VM_DNS_TIMEOUT", "5"))
+
+
+def relay(server: socket.socket, query: bytes, client: tuple) -> None:
+    """Forward one query upstream and return the reply to the client.
+
+    One short-lived socket per query: DNS/UDP has no connection to reuse, and a
+    per-query socket gives us the reply correlation for free.
+    """
+    try:
+        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as up:
+            up.settimeout(TIMEOUT)
+            up.sendto(query, (UPSTREAM_HOST, UPSTREAM_PORT))
+            reply, _ = up.recvfrom(65535)
+        server.sendto(reply, client)
+    except (socket.timeout, OSError):
+        pass  # a dropped query is a client-side retry, not a server error
+
+
+def main() -> None:
+    server = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    server.bind((LISTEN_HOST, LISTEN_PORT))
+    print(f"dns proxy: {LISTEN_HOST}:{LISTEN_PORT} -> {UPSTREAM_HOST}:{UPSTREAM_PORT}", flush=True)
+    while True:
+        try:
+            query, client = server.recvfrom(65535)
+        except OSError:
+            continue
+        threading.Thread(target=relay, args=(server, query, client), daemon=True).start()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/mac/vm/vm-wait.sh b/scripts/mac/vm/vm-wait.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a06e384104a6f5b0031fd6711dabbf6934ea768a
--- /dev/null
+++ b/scripts/mac/vm/vm-wait.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env zsh
+# Block until a VM is ready — sourced by init.zsh.
+#
+# Replaces the hand-typed poll loop: `ssh host check` re-run by eye until it
+# passes, with no bound and no way to tell a booting host from a dead one.
+#
+#   vmwait <host> <ready-cmd> [max-wait=600] [max-connect-fail=5]
+#
+# Probes in two stages so the two failure modes stay distinguishable:
+# a cheap `ssh host true` for reachability, then the caller's predicate. A host
+# that is up but not ready keeps waiting; a host that never answers gives up
+# and says so, rather than polling a powered-off VM forever.
+#
+#   0  ready
+#   1  reachable, predicate never satisfied within max-wait
+#   2  unreachable — max-connect-fail consecutive probe failures
+#   3  usage error
+#
+# Backoff doubles from 2s to a 30s cap. The deadline is checked before each
+# sleep as well as before each probe, so a long backoff cannot overshoot it.
+#
+#   vmwait testing-vm 'systemctl is-active ps-agent' 300
+#   vmwait ariel@192.168.64.6 'test -f /var/db/ps-agent/.installed'
+#   vmwait winvm 'sc query PromptMonitor | findstr RUNNING' 180 || return 1
+
+vmwait() {
+  emulate -L zsh
+  setopt no_unset
+
+  if (( $# < 2 )); then
+    print -u2 -- "usage: vmwait <host> <ready-cmd> [max-wait=600] [max-connect-fail=5]"
+    return 3
+  fi
+
+  local host="$1" ready_cmd="$2"
+  local -i max_wait="${3:-600}" max_connect_fail="${4:-5}"
+  local -i start=$(date +%s) connect_fail=0 backoff=2 cap=30 now
+  local state=CONNECT_PROBE
+
+  local _log; _log() { print -u2 -r -- "[vmwait][$state] $*"; }
+
+  _log "target=$host ready='$ready_cmd' max_wait=${max_wait}s"
+
+  while true; do
+    case "$state" in
+
+      CONNECT_PROBE)
+        if ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
+               "$host" true >/dev/null 2>&1; then
+          connect_fail=0
+          state=RUN_CHECK
+        else
+          (( connect_fail++ ))
+          _log "connect probe failed ($connect_fail/$max_connect_fail)"
+          (( connect_fail >= max_connect_fail )) && state=FAIL_UNREACHABLE || state=SLEEP_BACKOFF
+        fi
+        ;;
+
+      RUN_CHECK)
+        now=$(date +%s)
+        if (( now - start >= max_wait )); then state=FAIL_TIMEOUT; continue; fi
+        if ssh -o ConnectTimeout=5 "$host" "$ready_cmd" >/dev/null 2>&1; then
+          state=SUCCESS
+        else
+          _log "not ready yet"
+          state=SLEEP_BACKOFF
+        fi
+        ;;
+
+      SLEEP_BACKOFF)
+        now=$(date +%s)
+        if (( now - start >= max_wait )); then state=FAIL_TIMEOUT; continue; fi
+        sleep "$backoff"
+        (( backoff = backoff * 2 > cap ? cap : backoff * 2 ))
+        state=CONNECT_PROBE
+        ;;
+
+      SUCCESS)
+        _log "ready after $(( $(date +%s) - start ))s"
+        return 0
+        ;;
+
+      FAIL_TIMEOUT)
+        _log "gave up after ${max_wait}s waiting on '$ready_cmd'"
+        return 1
+        ;;
+
+      FAIL_UNREACHABLE)
+        _log "$max_connect_fail consecutive connect failures — $host looks down, not booting"
+        _log "check power/network/VPN before re-running; this will not self-heal a dead host"
+        return 2
+        ;;
+
+      *)
+        _log "unknown state '$state'"
+        return 3
+        ;;
+    esac
+  done
+}
