diff --git a/scripts/mac/vm/vpn-nat.sh b/scripts/mac/vm/vpn-nat.sh
new file mode 100644
index 0000000000000000000000000000000000000000..178347bc341a1659540932bc6cf3470712fd359c
--- /dev/null
+++ b/scripts/mac/vm/vpn-nat.sh
@@ -0,0 +1,125 @@
+# vm_vpn_nat — share the host's corp VPN with a local VM via pf NAT.
+#
+# The AWS VPN client installs split-default routes (1/8, 2/7, 4/6, 8/5 …) that
+# capture nearly all of 0.0.0.0/0, so a VM's packets enter the tunnel with their
+# own source address and the far end drops them. IP forwarding alone never fixes
+# this — the source has to be rewritten, which means NAT on the tunnel itself.
+#
+# The `no nat` rule matters as much as the nat rule: the VPN's resolver lives on
+# the tunnel's *own* address, so NAT'ing traffic to it makes the query arrive
+# from itself and the reply never returns. Excluding it keeps the VM's real
+# source, letting the resolver answer over the VM bridge — which is what lets the
+# VM resolve internal split-horizon names instead of hardcoding them in /etc/hosts.
+#
+#   vm_vpn_nat            detect tunnel, enable forwarding + NAT (sudo)
+#   vm_vpn_nat status     forwarding state, tunnel, active rules
+#   vm_vpn_nat stop       flush the anchor + disable forwarding (sudo)
+#
+# Non-persistent by design: rerun after host reboot, VPN reconnect, or any change
+# that moves the utun index.
+#
+# Overridable (export before calling):
+#   VM_SUBNET=192.168.65.0/24   VPN_DNS=100.64.0.1   VM_NAT_ANCHOR=vm-vpn
+
+vm_vpn_nat() {
+  emulate -L zsh
+  local subnet="${VM_SUBNET:-192.168.65.0/24}"
+  local vpn_dns="${VPN_DNS:-100.64.0.1}"
+  local anchor="${VM_NAT_ANCHOR:-vm-vpn}"
+
+  # The tunnel is whichever interface currently routes to the VPN resolver.
+  # Detected each run because the utun index changes across reconnects.
+  __vmnat_iface() { route -n get "$vpn_dns" 2>/dev/null | awk '/interface:/{print $2}'; }
+
+  __vmnat_apply() {
+    local iface; iface=$(__vmnat_iface)
+    if [[ -z "$iface" || "$iface" != utun* ]]; then
+      echo "✗ no VPN route to $vpn_dns (route iface: '${iface:-none}')." >&2
+      echo "  Connect the corp VPN, then rerun: vm_vpn_nat" >&2
+      return 1
+    fi
+    echo "VPN tunnel: $iface   |   VM subnet: $subnet   |   resolver: $vpn_dns"
+
+    sudo sysctl -w net.inet.ip.forwarding=1 >/dev/null || return 1
+
+    # Reference the anchor from the main ruleset, right after the com.apple
+    # nat-anchor so pf's translation-before-filtering section order stays valid.
+    # Reloads /etc/pf.conf verbatim otherwise — no system rules lost. This has to
+    # run every time: a host reboot drops the reference, and rules loaded into an
+    # unreferenced anchor parse fine and silently never match.
+    if ! awk '{print} /^nat-anchor "com\.apple/{print "nat-anchor \"'"$anchor"'\""}' \
+         /etc/pf.conf | sudo pfctl -f - 2>/dev/null; then
+      echo "✗ failed to load pf ruleset with anchor reference." >&2
+      return 1
+    fi
+
+    # pf is first-match: the DNS exception has to precede the catch-all.
+    if ! printf 'no nat on %s from %s to %s\nnat on %s from %s to any -> (%s)\n' \
+         "$iface" "$subnet" "$vpn_dns" \
+         "$iface" "$subnet" "$iface" \
+         | sudo pfctl -a "$anchor" -f - 2>/dev/null; then
+      echo "✗ failed to load NAT rules into anchor '$anchor'." >&2
+      return 1
+    fi
+
+    sudo pfctl -e 2>/dev/null   # nonzero when already enabled — expected
+    __vmnat_dns_start || return 1
+    echo "✓ NAT + DNS active. In the VM, point DNS at this host:"
+    echo "    sudo networksetup -setdnsservers Ethernet $(__vmnat_bridge_ip)"
+  }
+
+  # The VM-facing bridge address — where the DNS forwarder listens.
+  __vmnat_bridge_ip() { echo "${subnet%.0/24}.1"; }
+
+  # The VPN resolver refuses queries whose source isn't the host itself, and
+  # NAT'ing them makes the query arrive from the resolver's own address and loop.
+  # Neither works, so relay through the host instead: it can query upstream fine.
+  __vmnat_dns_start() {
+    local listen; listen=$(__vmnat_bridge_ip)
+    local proxy="${DEV_ENV_ROOT:-$HOME/Documents/projects/dev-env}/scripts/mac/vm/bin/vpn-dns-proxy.py"
+    if sudo lsof -nP -iUDP:53 2>/dev/null | grep -q "$listen:53"; then
+      echo "dns proxy: already listening on $listen:53"
+      return 0
+    fi
+    [[ -r "$proxy" ]] || { echo "✗ dns proxy not found at $proxy" >&2; return 1; }
+    # Absolute interpreter: a bare `python3` hits the modern-python PATH shim.
+    VM_DNS_LISTEN_HOST="$listen" VM_DNS_UPSTREAM_HOST="$vpn_dns" \
+      sudo nohup /usr/bin/python3 "$proxy" >"${TMPDIR:-/tmp}/vpn-dns-proxy.log" 2>&1 &
+    sleep 1
+    if sudo lsof -nP -iUDP:53 2>/dev/null | grep -q "$listen:53"; then
+      echo "dns proxy: listening on $listen:53 -> $vpn_dns:53"
+    else
+      echo "✗ dns proxy failed to start — see ${TMPDIR:-/tmp}/vpn-dns-proxy.log" >&2
+      return 1
+    fi
+  }
+
+  __vmnat_dns_stop() {
+    local pid; pid=$(sudo lsof -nP -iUDP:53 2>/dev/null | awk 'NR>1{print $2; exit}')
+    [[ -n "$pid" ]] && sudo kill "$pid" 2>/dev/null && echo "dns proxy: stopped (pid $pid)"
+  }
+
+  __vmnat_status() {
+    local iface; iface=$(__vmnat_iface)
+    echo "ip.forwarding : $(sysctl -n net.inet.ip.forwarding 2>/dev/null)"
+    echo "VPN iface     : ${iface:-none} (route to $vpn_dns)"
+    echo "anchor '$anchor':"
+    local rules; rules=$(sudo pfctl -a "$anchor" -s nat 2>/dev/null)
+    if [[ -n "$rules" ]]; then print -r -- "$rules" | sed 's/^/  /'; else echo "  (none)"; fi
+  }
+
+  __vmnat_stop() {
+    __vmnat_dns_stop
+    sudo pfctl -a "$anchor" -F nat 2>/dev/null
+    sudo pfctl -f /etc/pf.conf 2>/dev/null   # drop the anchor reference
+    sudo sysctl -w net.inet.ip.forwarding=0 >/dev/null
+    echo "✓ teardown done."
+  }
+
+  case "${1:-apply}" in
+    apply|"") __vmnat_apply ;;
+    status)   __vmnat_status ;;
+    stop)     __vmnat_stop ;;
+    *) echo "usage: vm_vpn_nat [apply|status|stop]" >&2; return 2 ;;
+  esac
+}
