diff --git a/scripts/terminal/term/bin/kitty-agent-title b/scripts/terminal/term/bin/kitty-agent-title
index f59bd13a306b41ba8e93646ba550b349defab2bd..2fc3a461144dc6c40420f1148fbcdbb41975a302 100755
--- a/scripts/terminal/term/bin/kitty-agent-title
+++ b/scripts/terminal/term/bin/kitty-agent-title
@@ -187,6 +187,30 @@ if [ -n "$SET_OK" ] && [ -n "${KITTY_WINDOW_ID:-}" ]; then
     : >"$FLAG_DIR/win-${KITTY_WINDOW_ID}.$SCOPE" 2>/dev/null || true
 fi
 
+# Roster record for scripts/ai/agents/bin/agents. This hook is the only place
+# where a kitty window id and an agent session id are both in scope: the window
+# id comes from the pane's environment, the session id from the hook payload, and
+# nothing outside can pair them — macOS refuses to show another process's
+# environment (`ps eww` prints nothing), and the agent does not hold its
+# transcript file open for lsof to find.
+#
+# Written unconditionally, not gated on SET_OK: a pane whose title could not be
+# set is still an addressable agent, and that is the fact the roster records.
+# One mkdir and one printf, no subprocess and no date call — the reader takes the
+# timestamp from the file's mtime. That matters because this also runs on
+# PreToolUse, where the whole hook costs ~30ms and is paid on every tool call.
+#
+# Fields are \x1f-separated for the same reason they are above: \x1f cannot occur
+# in any of these values, so there is nothing to quote or escape, and no cwd
+# containing a quote can produce a record the reader then chokes on.
+if [ -n "${KITTY_WINDOW_ID:-}" ]; then
+  ROSTER_DIR="${TMPDIR:-/tmp}/kitty-agent-title/roster"
+  mkdir -p "$ROSTER_DIR" 2>/dev/null &&
+    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
+      "$KITTY_WINDOW_ID" "$AGENT" "$SESSION_ID" "$CWD" "$TRANSCRIPT" "$STATE" "$TITLE" \
+      >"$ROSTER_DIR/win-${KITTY_WINDOW_ID}.rec" 2>/dev/null || true
+fi
+
 # Fallback for non-kitty terminals: OSC 2 sets the window title, OSC 30 the tab
 # title. Skipped when kitten already did the job, since a program-set title would
 # just be redundant here.
diff --git a/scripts/utils/slack/README.md b/scripts/utils/slack/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..dd980a5af13aec7146beecc793cbcc4466aea0b3
--- /dev/null
+++ b/scripts/utils/slack/README.md
@@ -0,0 +1,31 @@
+# slack
+
+Keep the `slack` MCP server (korotovsky/slack-mcp-server) usable from Claude Code.
+
+The server authenticates in **stealth mode** with the browser's `xoxc` token and `d`
+cookie — no Slack app, no admin approval. Those credentials rotate (hours to weeks),
+and when they do every tool call returns `invalid_auth`. `slack-refresh` re-harvests
+them and re-registers the server in one command.
+
+## Commands
+
+- `slack-refresh [--port N] [--team ID]` — harvest fresh creds over CDP and re-register
+  the `slack` MCP server at user scope. Downloads the prebuilt server binary to
+  `~/.cache/slack-mcp/` on first run. **Restart Claude Code afterwards** so the running
+  session reloads the new tokens.
+- `slack-cdp [--port N]` — (re)launch Slack with `--remote-debugging-port` (default 9333;
+  9222 is usually taken by a Chrome debug instance). No-op if it's already up.
+- `slack-creds [--port N] [--team ID]` — print the current `XOXC`/`XOXD`/`UA` without
+  changing any config. Useful for a second workspace: pass its team id from
+  `localConfig_v2.teams` (e.g. Prompt Security `T05RRSL7GKV`) and wire up a second server.
+
+## Notes
+
+- The server runs from a **binary**, not `npx` — public npm is blocked here (npm is pinned
+  to a private CodeArtifact registry). `slack-refresh` fetches the binary via `gh`.
+- Enterprise Grid needs `SLACK_MCP_USER_AGENT` (matched to the Slack app) and
+  `SLACK_MCP_CUSTOM_TLS=true`; `slack-refresh` sets both. Posting is enabled via
+  `SLACK_MCP_ADD_MESSAGE_TOOL=true`.
+- Reading messages straight off disk is **not** worth it: the on-disk IndexedDB message
+  cache is AES-encrypted under a custom-wrapped key, and the Service Worker cache is
+  compressed. Go through the API/MCP.
diff --git a/scripts/utils/slack/slack.sh b/scripts/utils/slack/slack.sh
new file mode 100644
index 0000000000000000000000000000000000000000..edfb2822ec0a0adda75ad51b299ff9a44a72a387
--- /dev/null
+++ b/scripts/utils/slack/slack.sh
@@ -0,0 +1,107 @@
+# Slack MCP helpers — refresh browser creds and (re)register the `slack` MCP server.
+#
+#   slack-refresh [--port N] [--team ID]   harvest fresh xoxc/xoxd via CDP, re-register `slack` (user scope)
+#   slack-cdp     [--port N]               (re)launch Slack with remote debugging on <port> (default 9333)
+#   slack-creds   [--port N] [--team ID]   print current XOXC/XOXD/UA without touching any config
+#
+# Run slack-refresh when the `slack` MCP tools start returning invalid_auth (the
+# xoxc/xoxd pair rotates). Restart Claude Code afterwards so the session reloads them.
+# Port defaults to 9333 because 9222 is usually taken by a Chrome debug instance.
+
+slack-cdp() {
+  emulate -L zsh
+  local port=9333 app='/Applications/Slack.app/Contents/MacOS/Slack'
+  while (( $# )); do
+    case "$1" in
+      --port) port="$2"; shift 2 ;;
+      *) shift ;;
+    esac
+  done
+  if curl -fsS "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
+    print -r -- "Slack already on CDP :$port"
+    return 0
+  fi
+  if [ ! -x "$app" ]; then
+    print -ru2 -- "Slack not found at $app"
+    return 1
+  fi
+  osascript -e 'quit app "Slack"' >/dev/null 2>&1
+  sleep 3
+  "$app" --remote-debugging-port="$port" >/dev/null 2>&1 &!
+  local i
+  for i in {1..25}; do
+    if curl -fsS "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
+      print -r -- "Slack on CDP :$port"
+      return 0
+    fi
+    sleep 1
+  done
+  print -ru2 -- "Slack CDP :$port did not come up"
+  return 1
+}
+
+slack-creds() {
+  emulate -L zsh
+  local root="${DEV_ENV_ROOT:-$HOME/Documents/projects/dev-env}"
+  slack-cdp "$@" >/dev/null || return 1
+  uv run --with websockets python "$root/scripts/utils/slack/bin/slack-harvest.py" "$@"
+}
+
+# Ensure the prebuilt slack-mcp-server binary exists (npx is blocked here: npm is
+# pinned to a private CodeArtifact registry). Echoes the binary path on stdout.
+__slack_ensure_binary() {
+  emulate -L zsh
+  local bin="$HOME/.cache/slack-mcp/slack-mcp-server"
+  if [ -x "$bin" ]; then
+    print -r -- "$bin"
+    return 0
+  fi
+  local arch=darwin-arm64
+  [ "$(uname -m)" = x86_64 ] && arch=darwin-amd64
+  mkdir -p "${bin:h}"
+  if ! gh release download --repo korotovsky/slack-mcp-server \
+        --pattern "slack-mcp-server-$arch" --dir "${bin:h}" --clobber >/dev/null 2>&1; then
+    print -ru2 -- "failed to download slack-mcp-server-$arch via gh"
+    return 1
+  fi
+  mv -f "${bin:h}/slack-mcp-server-$arch" "$bin"
+  chmod +x "$bin"
+  xattr -dr com.apple.quarantine "$bin" 2>/dev/null
+  print -r -- "$bin"
+}
+
+slack-refresh() {
+  emulate -L zsh
+  local root="${DEV_ENV_ROOT:-$HOME/Documents/projects/dev-env}"
+  local bin creds
+  bin="$(__slack_ensure_binary)" || return 1
+  slack-cdp "$@" || return 1
+  if ! creds="$(uv run --with websockets python "$root/scripts/utils/slack/bin/slack-harvest.py" "$@")"; then
+    print -ru2 -- "harvest failed"
+    return 1
+  fi
+  local xoxc xoxd ua line
+  while IFS= read -r line; do
+    case "$line" in
+      XOXC=*) xoxc="${line#XOXC=}" ;;
+      XOXD=*) xoxd="${line#XOXD=}" ;;
+      UA=*)   ua="${line#UA=}" ;;
+    esac
+  done <<< "$creds"
+  if [ -z "$xoxc" ] || [ -z "$xoxd" ]; then
+    print -ru2 -- "missing token/cookie in harvest output"
+    return 1
+  fi
+  claude mcp remove slack -s user >/dev/null 2>&1
+  if ! claude mcp add slack -s user \
+      -e "SLACK_MCP_XOXC_TOKEN=$xoxc" \
+      -e "SLACK_MCP_XOXD_TOKEN=$xoxd" \
+      -e "SLACK_MCP_USER_AGENT=$ua" \
+      -e "SLACK_MCP_CUSTOM_TLS=true" \
+      -e "SLACK_MCP_ADD_MESSAGE_TOOL=true" \
+      -- "$bin" --transport stdio; then
+    print -ru2 -- "claude mcp add failed"
+    return 1
+  fi
+  print -r -- "slack MCP refreshed → $bin. Restart Claude Code to load the new tokens."
+}
