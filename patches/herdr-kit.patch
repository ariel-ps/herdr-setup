+
 [[actions]]
 id = "names"
 title = "Sync agent names from sessions"
@@ -70,3 +85,34 @@ command = ["zsh", "-c", "source ./shell/herdr.sh && herdr-colorize"]
 id = "alerts"
 title = "List the named alerts"
 command = ["zsh", "./alert-hook.sh", "--list"]
+
+[[actions]]
+id = "doomface-stop-all"
+title = "Stop all doom faces"
+command = ["zsh", "./doomface-hook.sh", "--stop-all"]
+
+# A real tiled pane, not the corner overlay: split/tab/zoomed plugin panes
+# "are normal Herdr panes after they open" (Herdr's own plugins.mdx), unlike
+# `popup` (session-modal, steals all input) or the default `overlay`
+# (transient, closes itself). This is the one that stays put as a widget.
+[[panes]]
+id = "doomface-widget"
+title = "Doom Face"
+platforms = ["macos", "linux"]
+placement = "split"
+command = ["sh", "-c", "if command -v uv >/dev/null 2>&1; then exec uv run --no-project python ./bin/herdr-doomface-widget; else exec python3 ./bin/herdr-doomface-widget; fi"]
